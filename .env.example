# Marga — Environment Variables
# Copy this file to .env and fill in optional values.
# The app runs with ZERO keys — all fields below are optional.

# ─── Backend ─────────────────────────────────────────────
# Path to the SQLite database file
MARGA_DB_PATH=./marga.db

# JWT secret — change to a random 32+ character string in production
MARGA_JWT_SECRET=change-me-to-a-random-secret

# Port for the backend server (default 8000)
PORT=8000

# Optional: Gemini API key for LLM-polished explanations (free tier)
# Get one at: https://aistudio.google.com/app/apikey
# Without this, the app uses deterministic text templates (equally informative).
GEMINI_API_KEY=

# Optional: Ollama base URL for local LLM polish (no key required)
# OLLAMA_BASE_URL=http://localhost:11434

# ─── Frontend (Vite env vars, must be prefixed VITE_) ────
# Backend API URL (used by the frontend to call the API)
VITE_API_URL=http://localhost:8000

# Set to "1" to run the frontend in fully static demo mode (no backend needed)
# Useful for the presentation if the free backend tier is asleep
VITE_STATIC_DEMO=0

# Set to "1" to show DEMO DATA and DEMO DETECTOR badges
VITE_DEMO_MODE=1

# MapLibre tile style URL (leave blank to use the default from config/settings.yaml)
VITE_MAP_STYLE=
